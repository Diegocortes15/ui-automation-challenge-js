    "@wdio/mocha-framework": "^9.12.6",
    "@wdio/spec-reporter": "^9.12.6",
    "@wdio/visual-service": "^9.0.0",
    "eslint": "^9.31.0",
    "eslint-plugin-wdio": "^9.16.2",
    "globals": "^16.3.0",
    "nodemon": "^3.1.10",
    "rimraf": "^6.0.1"
  },
