  "description": "WDIO Atomation saucedemo",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "clean:allure": "rimraf ./allure-report && rimraf ./allure-results",
    "test": "npm run clean:allure && wdio run ./wdio.conf.js",
    "wdio": "wdio run ./wdio.conf.js",
